# Denario environment configuration
# cp .env.example .env

# LLM API keys (set only the providers you use)
OPENAI_API_KEY=your_openai_or_university_key
GOOGLE_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional
PERPLEXITY_API_KEY=your_perplexity_api_key
SEMANTIC_SCHOLAR_KEY=your_semantic_scholar_key
FUTURE_HOUSE_API_KEY=your_future_house_key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gemini.json  # Vertex AI service account


# Custom / OpenAI-compatible endpoint (e.g. a university gen-AI proxy)

# Route all OpenAI-type traffic to your proxy. Set BOTH names: the two layers
# read different ones (openai SDK in cmbagent/autogen reads OPENAI_BASE_URL;
# LangChain ChatOpenAI in the core readers reads OPENAI_API_BASE).
# Use OpenAI-type models only (gpt-*, o3-*) — Gemini/Claude clients are NOT redirected.
OPENAI_BASE_URL=https://your-endpoint.example.edu/v1
OPENAI_API_BASE=https://your-endpoint.example.edu/v1


# Model-id overrides (optional)

# Only needed if your endpoint rejects Denario's dated default model ids.
# JSON map of {dated_id: id_your_proxy_accepts}; keep the value single-quoted.
# DENARIO_MODEL_OVERRIDES='{"gpt-4o-2024-11-20": "gpt-4o", "gpt-4.1-2025-04-14": "gpt-4.1", "o3-mini-2025-01-31": "o3-mini"}'
